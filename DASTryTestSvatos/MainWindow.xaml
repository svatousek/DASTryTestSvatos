<Window x:Class="DASTryTestSvatos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DASTryTestSvatos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <DataGrid x:Name="MoviesDataGrid" AutoGenerateColumns="True" Margin="10"></DataGrid>
        <Button Content="Načíst filmy" Click="LoadMovies_Click" VerticalAlignment="Bottom" Margin="10"></Button>
        <Button Content="Insert Into" Click="InsertInto_Click" VerticalAlignment="Bottom" Margin="10"></Button>

    </Grid>
</Window>
